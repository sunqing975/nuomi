# 依赖与产物
node_modules/
dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.tsbuildinfo
desktop/src-tauri/target/

# 打包产物（PyInstaller sidecar 构建物，由 scripts/build_sidecar.sh 生成）
backend/build/
desktop/src-tauri/binaries/

# 运行时数据（含密钥掩码、用户与会话数据，不进版本库）
backend/data/

# 本地配置
.env
.DS_Store

# make 脚本的 PID 与日志
.logs/

# 测试副作用：octop 以 `:memory:` 作路径时会派生出这个文件
:memory:*

# vite dev 缓存
frontend/.vite/

# FBX→VRMA 转换工具链（FBX2glTF 二进制 12MB，可从 GitHub releases 下载，不入库）
shells/nuomi-avatar/tools/fbx2vrma/FBX2glTF-darwin-x64
.npm-cache/

# Electron 下载缓存（91MB 二进制，electron-builder/npm install 自动拉取，不入库）
shells/nuomi-avatar/.electron-cache/

# 壳的本机运行态配置：后端切模型/开关会回写 ui.*，入库=git status 长期脏 +
# 把上一台机器的模型绝对路径当代码提交（模板见 config.example.json，首启自动播种）
shells/nuomi-avatar/config.json

# 模拟 MES 演示数据（生成物，scripts/gen_mes_data.py 可复现）
connectors/data/
