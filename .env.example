# 糯米 V2 · 环境变量示例
# 复制为 .env 后填写；不填时后端自动读取系统环境变量（如已导出的 DEEPSEEK_API_KEY）

# --- LLM（OpenAI 兼容接口，默认 DeepSeek） ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 优先级：LLM_API_KEY > DEEPSEEK_API_KEY > ARK_API_KEY
LLM_API_KEY=

# --- 本地 llama.cpp（OpenAI 兼容）示例 ---
# 启动：/Users/superman/scripts/serve-qwen3.5-2b.sh start（默认 8080）
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=Qwen3.5-2B        # llama.cpp 会忽略 model 名，用加载的模型
# LLM_API_KEY=local-no-key    # llama.cpp 不校验 key，占位即可

# --- 豆包（火山方舟）示例：取消注释并按需填写 ---
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-你的接入点ID
# LLM_API_KEY=

# --- 存储（相对 backend/） ---
# DB_PATH=data/nuomi.sqlite

# --- skills 目录（默认仓库根 /skills） ---
# SKILLS_DIR=../skills
