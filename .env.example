# 糯米 V2 · 环境变量示例
# 复制为 .env 后填写；不填时后端自动读取系统环境变量（如已导出的 DEEPSEEK_API_KEY）

# --- LLM（OpenAI 兼容接口，默认 DeepSeek） ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 优先级：LLM_API_KEY > DEEPSEEK_API_KEY > ARK_API_KEY
LLM_API_KEY=

# --- 本地 llama.cpp（OpenAI 兼容）示例 ---
# 启动：/Users/superman/scripts/serve-qwen3.5-2b.sh start（默认 8080）
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=Qwen3.5-2B        # llama.cpp 会忽略 model 名，用加载的模型
# LLM_API_KEY=local-no-key    # llama.cpp 不校验 key，占位即可

# --- 豆包（火山方舟）示例：取消注释并按需填写 ---
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-你的接入点ID
# LLM_API_KEY=

# --- 数据根（桌面化单一数据根；不填时默认 ~/Library/Application Support/Nuomi） ---
# NUOMI_HOME=~/Library/Application Support/Nuomi

# --- 工作区（shell/fs 工具的操作根目录；默认 ~/Documents/Nuomi，首启自动创建） ---
# 优先级：NUOMI_WORKSPACE / WORKSPACE_DIR > 运行时设置（首启向导）> 默认路径
# WORKSPACE_DIR=~/Documents/Nuomi

# --- 本地 API 守卫（桌面形态） ---
# NUOMI_TOKEN 显式设置时后端强制校验请求头 X-Nuomi-Token（Tauri 壳每次启动自动生成并传入，
# 一般无需手填；手动起后端调试时可设同值）。未设置且非打包形态 → 不校验（web dev 不受影响）。
# NUOMI_TOKEN=

# --- 资源目录（默认仓库 plugins/、partners/；打包形态由 sidecar 指向内嵌只读区） ---
# PLUGINS_DIR=../plugins
# PARTNERS_DIR=../partners
