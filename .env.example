# 糯米 V2 · 本地环境配置（gitignored，仅本机生效）
# 当前策略：测试用 DeepSeek（工具调用可靠）；本地 Qwen3.5-2B 适合纯对话，
# 实测工具调用不稳定，切换方式见下方注释。

# --- 数据根 / 工作区（单根：工作区=数据根；默认 macOS ~/Library/Application Support/Nuomi，不设置则用默认） ---
# NUOMI_HOME=/Users/superman/Nuomi

# --- DeepSeek（测试主力） ---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-api-key
LLM_TEMPERATURE=0.7

# --- 本地 llama.cpp Qwen3.5-2B（要切回时取消注释下面 4 行，并注释上面 DeepSeek 4 行） ---
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=Qwen3.5-2B
# LLM_API_KEY=local-no-key
# LLM_TEMPERATURE=0.7

# MCP 服务器（JSON，langchain-mcp-adapters 格式）
# NUOMI_CONNECTORS={"pet_mood":{"transport":"stdio","command":"python","args":["examples/pet_mood_server.py"]}}
